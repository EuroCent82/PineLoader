<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PineLoader</AssemblyName>
    <Product>PineLoader</Product>
    <Version>1.0.3</Version>
    <RootNamespace>PineLoader</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationTitle>PineLoader</ApplicationTitle>
    <ApplicationIcon>brand\pine.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src\**" />
    <Compile Remove="examples\**" />
    <Compile Remove="website\**" />
    <Content Include="brand\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Remove="src\**" />
    <Content Remove="examples\**" />
    <Content Remove="website\**" />
    <None Remove="src\**" />
    <None Remove="examples\**" />
    <None Remove="website\**" />
    <EmbeddedResource Remove="src\**" />
    <EmbeddedResource Remove="examples\**" />
    <EmbeddedResource Remove="website\**" />
  </ItemGroup>
  <Target Name="PublishJavaShim" AfterTargets="Publish" Condition="Exists('$(MSBuildThisFileDirectory)src\JavaShim\JavaShim.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src\JavaShim\JavaShim.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)src\JavaShim\bin\$(Configuration)\net10.0\win-x64\publish\PineJava.exe" DestinationFiles="$(PublishDir)shim\PineJava.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
