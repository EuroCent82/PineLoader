<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PineLoader</AssemblyName>
    <Product>PineLoader</Product>
    <Version>1.0.0</Version>
    <RootNamespace>PineLoader</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationTitle>PineLoader</ApplicationTitle>
    <ApplicationIcon>brand\pine.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src\**" />
    <Compile Remove="examples\**" />
    <Compile Remove="web\**" />
    <Content Include="brand\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Remove="src\**" />
    <Content Remove="examples\**" />
    <Content Remove="web\**" />
    <None Remove="src\**" />
    <None Remove="examples\**" />
    <None Remove="web\**" />
    <EmbeddedResource Remove="src\**" />
    <EmbeddedResource Remove="examples\**" />
    <EmbeddedResource Remove="web\**" />
  </ItemGroup>
</Project>
